[
  {
    "id": "hawaii-2024",
    "name": "Hawaii 2024",
    "description": "Our second year living on Oahu, exploring the island's incredible beaches, hiking trails, and local culture. From sunrise surf sessions to sunset luaus, Hawaii continues to amaze us every day.",
    "location": "Honolulu, HI",
    "date": "2024-12-12",
    "gps": {
      "lat": 21.3069,
      "lng": -157.8583
    },
    "tags": [
      "travel",
      "hawaii",
      "beach",
      "nature",
      "tropical"
    ],
    "cover": "/site-assets/photos/hawaii-2024/electric-beach-2.jpg",
    "photos": [
      {
        "title": "Electric Beach",
        "description": "The crystal-clear waters of Kahe Point Beach Park, known locally as Electric Beach. Named for the nearby power plant's warm water discharge, this spot is famous for incredible snorkeling with sea turtles and tropical fish.",
        "tags": [
          "beach",
          "ocean",
          "snorkeling"
        ],
        "image": "/site-assets/photos/hawaii-2024/electric-beach-2.jpg"
      },
      {
        "title": "Electric Beach Cove",
        "description": "A secluded cove at Electric Beach where sea turtles rest on the warm sand. The volcanic rock formations create natural tide pools perfect for exploring marine life.",
        "tags": [
          "beach",
          "wildlife"
        ],
        "image": "/site-assets/photos/hawaii-2024/electric-beach.jpg"
      },
      {
        "title": "Hanauma Bay View",
        "description": "The stunning turquoise waters of Hanauma Bay nature preserve. This ancient volcanic crater is one of the most popular snorkeling destinations in Hawaii.",
        "tags": [
          "bay",
          "nature"
        ],
        "image": "/site-assets/photos/hawaii-2024/IMG_0117.jpg"
      },
      {
        "title": "Green Sea Turtle",
        "description": "A Hawaiian green sea turtle (honu) resting on the beach. These gentle creatures are a sacred symbol in Hawaiian culture and are protected by law.",
        "tags": [
          "wildlife",
          "turtle"
        ],
        "image": "/site-assets/photos/hawaii-2024/IMG_1013.jpg"
      },
      {
        "title": "Honu Up Close",
        "description": "An intimate encounter with a green sea turtle on the North Shore. Watching these ancient creatures in their natural habitat is a humbling experience.",
        "tags": [
          "wildlife",
          "turtle"
        ],
        "image": "/site-assets/photos/hawaii-2024/IMG_1026.jpg"
      },
      {
        "title": "North Shore Waves",
        "description": "The legendary waves of Oahu's North Shore during winter swell season. Surfers from around the world come here to challenge some of the world's most powerful waves.",
        "tags": [
          "surfing",
          "waves"
        ],
        "image": "/site-assets/photos/hawaii-2024/IMG_1092.jpg"
      },
      {
        "title": "Waikiki Sunset",
        "description": "Golden hour over Waikiki Beach with Diamond Head silhouetted in the distance. These sunsets never get old, painting the sky in brilliant oranges and pinks every evening.",
        "tags": [
          "sunset",
          "beach"
        ],
        "image": "/site-assets/photos/hawaii-2024/IMG_1277.jpg"
      },
      {
        "title": "Paddle Boarding Paradise",
        "description": "Gliding across the calm waters of Ala Moana Beach Park on a stand-up paddleboard. The perfect way to start a Hawaiian morning.",
        "tags": [
          "paddleboarding",
          "beach"
        ],
        "image": "/site-assets/photos/hawaii-2024/IMG_1289.jpg"
      },
      {
        "title": "Tropical Garden",
        "description": "Lush tropical foliage at the Lyon Arboretum. Hawaii's year-round tropical climate supports an incredible diversity of plant life.",
        "tags": [
          "nature",
          "plants"
        ],
        "image": "/site-assets/photos/hawaii-2024/IMG_1450.jpg"
      },
      {
        "title": "Diamond Head Hike",
        "description": "The view from the Diamond Head summit trail. This iconic volcanic crater offers panoramic views of Waikiki, Honolulu, and the Pacific Ocean.",
        "tags": [
          "hiking",
          "views"
        ],
        "image": "/site-assets/photos/hawaii-2024/IMG_1663.jpg"
      },
      {
        "title": "Lifeguard Tower",
        "description": "A classic Hawaiian lifeguard tower standing watch over the beach. These colorful towers are an iconic symbol of Hawaiian beach culture.",
        "tags": [
          "beach",
          "lifeguard"
        ],
        "image": "/site-assets/photos/hawaii-2024/IMG_1731.jpg"
      },
      {
        "title": "Haleiwa Town",
        "description": "The charming surf town of Haleiwa on Oahu's North Shore. Famous for its shave ice shops, local boutiques, and laid-back surf culture.",
        "tags": [
          "town",
          "culture"
        ],
        "image": "/site-assets/photos/hawaii-2024/IMG_1752.jpg"
      },
      {
        "title": "Aloha Shirts",
        "description": "A colorful display of traditional Hawaiian aloha shirts. These vibrant garments have been a symbol of Hawaiian culture since the 1930s.",
        "tags": [
          "culture",
          "shopping"
        ],
        "image": "/site-assets/photos/hawaii-2024/IMG_1786.jpg"
      },
      {
        "title": "Mango Season",
        "description": "Fresh Hawaiian mangoes ripening on the tree. Nothing beats the sweetness of locally grown tropical fruit in Hawaii.",
        "tags": [
          "fruit",
          "nature"
        ],
        "image": "/site-assets/photos/hawaii-2024/IMG_1790.jpg"
      },
      {
        "title": "Makapuu Lookout",
        "description": "The dramatic cliffs of Makapuu Point on Oahu's eastern shore. This windward coast offers some of the island's most spectacular scenery.",
        "tags": [
          "cliffs",
          "views"
        ],
        "image": "/site-assets/photos/hawaii-2024/IMG_1823.jpg"
